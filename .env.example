# VITE_API_TARGET: адрес Java-бэкенда, на который Vite проксирует запросы /api
# в режимах `npm run dev` и `npm run preview`. По умолчанию http://localhost:8080.
VITE_API_TARGET="http://localhost:8080"

# PORT: порт dev-мока (`npm run dev:mock`, in-memory сервер server.ts). По умолчанию 3000.
# Мок только для локальной разработки и отказывается стартовать при NODE_ENV=production.
PORT=3000
