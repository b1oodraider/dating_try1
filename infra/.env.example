# Copy to infra/.env (git-ignored) and fill in real values.

DB_NAME=dating
DB_USER=dating_user
# Generate: openssl rand -base64 24
DB_PASSWORD=

# Signs photo URLs, >= 32 characters. Generate: openssl rand -hex 32
APP_MEDIA_URL_SIGNING_SECRET=

# Comma-separated origins of the web client, e.g. https://dating.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
