# Copy to infra/.env (git-ignored) and fill in real values.

DB_NAME=dating
DB_USER=dating_user
# Generate: openssl rand -base64 24
DB_PASSWORD=

# Signs photo URLs, >= 32 characters. Generate: openssl rand -hex 32
APP_MEDIA_URL_SIGNING_SECRET=

# Keys the phone hash that identifies accounts, >= 32 characters. Set once: changing it detaches
# every account from its phone. Generate: openssl rand -hex 32
APP_AUTH_PHONE_HASH_SECRET=

# Push notifications; leave empty to turn a provider off.
# RuStore console -> project -> Push: project id and service token.
APP_PUSH_RUSTORE_PROJECT_ID=
APP_PUSH_RUSTORE_SERVICE_TOKEN=
# Firebase service account key (JSON) path INSIDE the backend container, e.g. /run/secrets/fcm.json
APP_PUSH_FCM_CREDENTIALS_FILE=

# Comma-separated origins of the web client, e.g. https://dating.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Test accounts for QA (see docs/economy.md). Phones become test accounts isolated from real users;
# with ENABLED=true they log in with OTP_CODE (no SMS) and may use /api/v1/testing.
APP_TESTING_ENABLED=false
APP_TESTING_TEST_PHONES=
APP_TESTING_OTP_CODE=
